# Optional email configuration consumed by Docker Compose.
# Copy to .env in the repository root. Database credentials remain local
# demonstration values defined in docker-compose.yml.
EMAIL_ENABLED=false
SMTP_TIMEOUT_SECONDS=10
SENDER_EMAIL=your_email@example.com
EMAIL_PASSWORD=your_app_password
# Legacy spelling retained for compatibility with the handler.
RECIEVER_EMAIL=receiver@example.com
